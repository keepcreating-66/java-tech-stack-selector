<?xml version="1.0" encoding="UTF-8"?>
<!-- 对话式 Maven 根工程模板；需按已确认配置替换标识，并经过实际构建验证。
     单体使用 jar；多模块根工程使用 pom 并填写 modules。
     子模块的 parent 应指向项目父工程，不能直接复制本根工程模板。
     依赖只加入用户选中的组件；无缓存时不加入 Redis。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>${SPRING_BOOT_VERSION}</version>
        <relativePath/>
    </parent>
    <groupId>com.example</groupId>
    <artifactId>${PROJECT_NAME}</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>${PACKAGING}</packaging>
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <!-- ${MODULES_XML}: 仅在聚合根工程中填写 modules 元素 -->
    <dependencies>
        <!-- ${SELECTED_DEPENDENCIES_XML}: 按已选组件填写，含正确 JDBC 驱动 -->
    </dependencies>
    <!-- ${BUILD_XML}: 仅可执行应用模块启用 Spring Boot 打包插件 -->
</project>

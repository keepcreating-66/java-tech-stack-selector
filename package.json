{
  "name": "java-tech-stack-selector-workspace",
  "private": true,
  "version": "1.2.0-rc.1",
  "workspaces": [
    "packages/core",
    "vscode"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run typecheck && npm run build && node --test vscode/test/*.test.cjs tests/*.test.cjs",
    "test:projects": "npm run build && node vscode/test/verify-projects.cjs",
    "package:skill": "npm run build && python3 scripts/package_skill.py",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "^5.3.0",
    "@types/node": "^22.0.0"
  }
}

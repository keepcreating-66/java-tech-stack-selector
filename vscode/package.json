{
  "name": "java-tech-stack-selector",
  "displayName": "Java Tech Stack Selector",
  "description": "按系统架构选型并生成可验证的 Java 后端工程",
  "version": "1.1.0",
  "publisher": "java-tech-stack-developer",
  "license": "MIT",
  "repository": {"type": "git", "url": "https://github.com/keepcreating-66/java-tech-stack-selector.git"},
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "java",
    "spring-boot",
    "tech-stack",
    "scaffold",
    "backend"
  ],
  "activationEvents": [
    "onCommand:javaTechStack.start",
    "onCommand:javaTechStack.preset"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "javaTechStack.start",
        "title": "开始技术选型",
        "category": "Java Tech Stack"
      },
      {
        "command": "javaTechStack.preset",
        "title": "使用预设方案",
        "category": "Java Tech Stack"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.cjs",
    "test:projects": "npm run compile && node test/verify-projects.cjs",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  }
}

{
  "name": "java-tech-stack-selector",
  "displayName": "Java Tech Stack Selector",
  "description": "帮助Java开发者快速完成后端项目技术选型，支持表单式配置生成",
  "version": "1.0.0",
  "icon": "icon.svg",
  "publisher": "java-tech-stack-developer",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "java",
    "spring-boot",
    "tech-stack",
    "scaffold",
    "backend"
  ],
  "activationEvents": [
    "onCommand:javaTechStack.start",
    "onCommand:javaTechStack.preset"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "javaTechStack.start",
        "title": "开始技术选型",
        "category": "Java Tech Stack"
      },
      {
        "command": "javaTechStack.preset",
        "title": "使用预设方案",
        "category": "Java Tech Stack"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0"
  }
}
